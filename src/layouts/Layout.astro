---
import { Font } from "astro:assets";
import type { Profile } from "../data/profile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

const title = `${profile.name} — CV`;
const metaDescription = `CV of ${profile.name} — ${profile.title} based in ${profile.location}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 1200×630 link-preview card (LinkedIn, Slack, etc.) — a static image in
// public/, regenerate it by hand if the name or title changes.
const ogImage = new URL("/og.png", Astro.site);

// schema.org Person — lets search engines tie the page to the person.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  url: profile.website,
  email: `mailto:${profile.email}`,
  address: profile.location,
  sameAs: [profile.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={profile.name} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <!-- Scroll-reveal content starts at opacity 0 and relies on JS to show
         it — without JS, show it straight away. -->
    <noscript><style>[data-animate] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <!-- Read saved theme before first paint to avoid a flash of dark/light.
         Default is light — only an explicit "dark" choice (via the toggle
         in Nav.astro) keeps it dark; a first-time visitor with no stored
         preference gets light. -->
    <script is:inline>
      if (localStorage.getItem("theme") !== "dark") document.documentElement.classList.add("light");
    </script>
    <!-- Same pre-paint pattern for Corpo/Personality mode (Nav.astro's
         toggle) — default is personality; only an explicit "corpo" choice
         switches Summary/Contact into the more conservative phrasing. -->
    <script is:inline>
      if (localStorage.getItem("mode") === "corpo") document.documentElement.classList.add("corpo");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ─── Design tokens ─────────────────────────────────────────── */
  :root {
    --bg:        #111117;
    --bg-card:   #17171f;
    --bg-hover:  #1d1d28;
    --border:    #2a2a3c;
    --accent:    #7b9fff;
    --accent-2:  #b09df5;
    --text:      #eeeef4;
    --text-muted:#9898b8;
    --text-dim:  #63637a;

    /* --font-inter / --font-jetbrains-mono come from the Font components
       above (configured in astro.config.mjs). */
    --font-sans: var(--font-inter), system-ui, sans-serif;
    --font-mono: var(--font-jetbrains-mono);

    --radius:    8px;
    --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
    /* Clamp so sections breathe on desktop but stay tight on mobile */
    --section-gap: clamp(2rem, 4.5vw, 3.75rem);
    --content-width: 860px;
  }

  /* Light mode — only colour tokens need overriding */
  html.light {
    --bg:        #f4f4f8;
    --bg-card:   #ffffff;
    --bg-hover:  #ebebf2;
    --border:    #d8d8e8;
    --accent:    #4a6ef5;
    --accent-2:  #7c5cf0;
    --text:      #111117;
    --text-muted:#4a4a65;
    --text-dim:  #8888a0;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    scroll-behavior: smooth;
    font-size: clamp(15px, 1.1vw, 17px);
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    /* Smooth colour transition when toggling theme */
    transition: background-color 0.25s, color 0.25s;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  .section {
    padding: var(--section-gap) 1.25rem;
  }

  .section-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  /* Terminal-path style ("~/experience"), echoing the > dd mark. The h2
     text itself stays "Experience" — lowercase and "~/" are CSS only, and
     the "/ ''" alt text keeps screen readers from announcing "tilde slash". */
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: lowercase;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title::before {
    content: "~/" / "";
    color: var(--text-dim);
    /* cancel the flex gap so "~/" hugs the name */
    margin-right: -0.75rem;
  }

  .section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ─── Scroll-reveal ─────────────────────────────────────────── */
  /* Elements marked data-animate start invisible and slide up */
  [data-animate] {
    opacity: 0;
    transform: translateY(22px);
    /* Use --delay CSS var so each card in a list can stagger */
    transition:
      opacity 0.55s var(--ease-spring) var(--delay, 0ms),
      transform 0.55s var(--ease-spring) var(--delay, 0ms);
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Honour the OS preference — skip all animations */
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    * { animation-duration: 0.01ms !important; animation-delay: 0ms !important; }
  }

  /* ─── Mobile-only "Tell me more" collapse ──────────────────────
     Markup: a .collapse wrapper (with an id) around ONE inner element,
     plus a <button class="collapse-toggle" aria-controls="that-id">.
     Collapsed below 640px, animated via the grid-rows trick (0fr → 1fr)
     since height:auto can't be transitioned. Always fully visible on
     desktop, where the button is hidden. A real <button>, deliberately
     not <details> — Chromium hides closed-details content via an internal
     mechanism CSS can't override, so it can't be forced open on desktop or
     in print. The click handler is the single script at the bottom of this
     file. */
  .collapse-toggle {
    display: none;
    margin-top: 0.65rem;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--accent);
    cursor: pointer;
  }

  .collapse-toggle:hover { text-decoration: underline; }

  @media (max-width: 639px) {
    .collapse-toggle { display: inline-flex; width: fit-content; }

    .collapse {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s var(--ease-spring);
    }

    .collapse.is-expanded { grid-template-rows: 1fr; }

    .collapse > * {
      overflow: hidden;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collapse { transition: none; }
  }

  /* ─── Print / "Save as PDF" ────────────────────────────────────
     Hero.astro's button calls window.print(). Whatever voice is active
     (personality / corpo) is what gets printed. Component-specific print
     rules live in each component's own <style>. */
  .print-only { display: none; }

  @media print {
    @page { margin: 14mm 15mm; }

    /* Always print on white, whatever the screen theme */
    html, html.light {
      --bg:        #fff;
      --bg-card:   #fff;
      --bg-hover:  #fff;
      --border:    #d4d4dc;
      --accent:    #2f50d0;
      --accent-2:  #5b3fc4;
      --text:      #111117;
      --text-muted:#33334a;
      --text-dim:  #5a5a70;
      font-size: 13px;
    }

    body { line-height: 1.5; }

    .print-only  { display: revert; }
    .screen-only { display: none !important; }

    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }

    [data-animate] { opacity: 1 !important; transform: none !important; }

    /* Everything collapsible is expanded on paper */
    .collapse-toggle { display: none !important; }
    .collapse { display: block !important; }
    .collapse > * { overflow: visible !important; }

    .section { padding: 0 0 1.4rem; }

    /* Plain CV headings on paper — "~/experience" is a screen flourish */
    .section-title {
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 0.8rem;
      break-after: avoid;
    }

    .section-title::before { content: none; }
  }
</style>

<script>
  // ── Scroll-reveal ──────────────────────────────────────────────
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target); // fire once
        }
      });
    },
    { threshold: 0.01 }
  );

  document.querySelectorAll("[data-animate]").forEach((el) => revealObserver.observe(el));

  // ── Nav active state ───────────────────────────────────────────
  // rootMargin centres the trigger zone in the viewport, so the active
  // link updates when a section occupies the middle band of the screen.
  const navObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        document.querySelectorAll("header nav a[href^='#']").forEach((link) => {
          link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
        });
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );

  document.querySelectorAll("section[id]").forEach((s) => navObserver.observe(s));

  // ── "Tell me more" collapse (styles above) ─────────────────────
  // One handler for the whole page, so components never double-bind.
  document.querySelectorAll<HTMLButtonElement>(".collapse-toggle").forEach((btn) => {
    const target = document.getElementById(btn.getAttribute("aria-controls")!);
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "Tell me more" : "Tell me less";
      target?.classList.toggle("is-expanded", !expanded);
    });
  });
</script>
