---
import { Image } from "astro:assets";
import type { ExperienceItem } from "../data/experience";

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section class="section" id="experience">
  <div class="section-inner">
    <h2 class="section-title">Experience</h2>

    <div class="timeline">
      {items.map((item, i) => (
        <article class="entry" data-animate style={`--delay: ${i * 80}ms`}>
          <div class="entry-meta">
            <span class="period">{item.period}</span>
            <span class="location">{item.location}</span>
          </div>

          <div class="entry-body">
            <header class="entry-header">
              <h3 class="entry-title">
                {item.title}
                {item.level && <span class="level">{item.level}</span>}
              </h3>
              <p class="company">
                {item.logo && (
                  <span class="logo-badge">
                    <Image src={item.logo} alt="" width={200} loading="eager" decoding="sync" />
                  </span>
                )}
                {item.company}
              </p>
            </header>

            {/* Mobile-only — collapses the whole bullet list behind a
                toggle so the card isn't a wall of text on a small screen.
                Hidden entirely on desktop (see the min-width rule below),
                where every bullet is always visible. A real <button> (not
                a details/summary or checkbox hack) so it stays keyboard
                accessible without fighting the browser's own open/close
                behaviour. The grid-rows wrapper animates the reveal —
                0fr → 1fr — instead of a hard display:none/block cut. */}
            <div class="bullets-wrap" id={`bullets-${i}`}>
              <ul class="bullets">
                {item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>

            {item.bullets.length > 0 && (
              <button
                type="button"
                class="bullets-toggle"
                aria-expanded="false"
                aria-controls={`bullets-${i}`}
              >
                Tell me more
              </button>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("#experience .bullets-toggle").forEach((btn) => {
    const list = document.getElementById(btn.getAttribute("aria-controls")!);
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "Tell me more" : "Tell me less";
      list?.classList.toggle("is-expanded", !expanded);
    });
  });
</script>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .entry {
    display: grid;
    /* Meta column is fixed; body takes the rest */
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: clamp(1rem, 4vw, 1.5rem);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .entry:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent),
                0 8px 28px -6px color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-2px);
  }

  /* Stack meta above body on mobile, side-by-side on wider screens */
  @media (min-width: 640px) {
    .entry {
      grid-template-columns: 9rem 1fr;
      gap: 1.5rem;
    }
  }

  .entry-meta {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .entry-meta {
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 0.15rem;
    }
  }

  .period {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    white-space: nowrap;
  }

  .location {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .level {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 12%, transparent);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
  }

  .company {
    font-size: 0.875rem;
    color: var(--accent);
    margin-top: 0.2rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    padding: 0.25rem 0.4rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 5px;
    flex-shrink: 0;
  }

  .logo-badge img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 3rem;
    object-fit: contain;
  }

  .bullets-wrap {
    margin-top: 0.85rem;
  }

  .bullets {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .bullets li {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ─── Mobile-only "Tell me more" for the bullet list ────────────
     Collapsed by default below 640px, animated via a grid-rows trick
     (0fr → 1fr) since height:auto can't be transitioned directly. The
     button is hidden entirely above that breakpoint and the wrapper
     falls back to a plain block, always fully visible. */
  .bullets-toggle {
    display: none;
    margin-top: 0.6rem;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--accent);
    cursor: pointer;
  }

  .bullets-toggle:hover { text-decoration: underline; }

  @media (max-width: 639px) {
    .bullets-toggle { display: inline-flex; width: fit-content; }

    .bullets-wrap {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s var(--ease-spring);
    }

    .bullets-wrap.is-expanded {
      grid-template-rows: 1fr;
    }

    .bullets-wrap > .bullets {
      overflow: hidden;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bullets-wrap { transition: none; }
  }
</style>
