---
import type { Profile } from "../data/profile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

// Both registers render; Nav.astro's toggle (html.corpo) picks which one is
// visible via CSS, same mechanism as the light/dark tokens.
const voices = [
  { voice: "personality", paragraphs: profile.summary },
  { voice: "corpo", paragraphs: profile.summaryCorpo },
];
---

<section class="section hero" id="about">
  <div class="section-inner">
    <div class="name-row">
      <!-- Text uses var(--font-mono) via CSS below — the self-hosted font's
           family name is hashed, so it can't be named in an attribute. -->
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="2" y="2" width="60" height="60" rx="13" fill="#111117" />
        <text x="8" y="40" font-weight="600" font-size="20" fill="#7b9fff">&gt;</text>
        <text x="24" y="40" font-weight="700" font-size="20" fill="#eeeef4">dd</text>
      </svg>
      <h1>{profile.name}</h1>
    </div>
    <p class="title">{profile.title}</p>
    <p class="location">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      {profile.location}
    </p>
    <ul class="facts">
      {profile.highlights.map((fact) => (
        <li>{fact}</li>
      ))}
    </ul>

    <!-- On paper the pills print their actual address instead of a label. -->
    <nav class="links" aria-label="Contact and social links">
      <a href={`mailto:${profile.email}`} class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/>
        </svg>
        <span class="screen-only">Email</span>
        <span class="print-only">{profile.email}</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
        <span class="screen-only">LinkedIn</span>
        <span class="print-only">{profile.linkedin.replace("https://", "")}</span>
      </a>
      <a href={profile.website} target="_blank" rel="noopener noreferrer" class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <span class="screen-only">Website</span>
        <span class="print-only">{profile.website.replace("https://", "")}</span>
      </a>
      <!-- Opens the browser's print dialog — print styles (Layout.astro and
           each component) turn the page into a clean CV, in whichever
           voice is currently active. -->
      <button type="button" id="save-pdf" class="link-pill pdf-btn screen-only">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Save as PDF
      </button>
    </nav>

    <!-- First 2 paragraphs always visible; the rest collapse behind
         "Tell me more" on mobile only (.collapse in Layout.astro). -->
    {voices.map(({ voice, paragraphs }) => (
      <div class={`summary summary-${voice}`}>
        {paragraphs.slice(0, 2).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {paragraphs.length > 2 && (
          <>
            <div class="collapse summary-extra" id={`summary-${voice}-extra`}>
              <div>
                {paragraphs.slice(2).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </div>
            <button
              type="button"
              class="collapse-toggle"
              aria-expanded="false"
              aria-controls={`summary-${voice}-extra`}
            >
              Tell me more
            </button>
          </>
        )}
      </div>
    ))}
  </div>
</section>

<script>
  document.getElementById("save-pdf")?.addEventListener("click", () => window.print());
</script>

<style>
  .hero {
    position: relative;
    /* Clamp so mobile doesn't have excessive top whitespace */
    padding-top: clamp(2.5rem, 8vw, 5rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 420px;
    background: radial-gradient(
      ellipse at 50% 30%,
      color-mix(in srgb, var(--accent) 9%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .section-inner {
    position: relative;
    /* Single-column natural stack — no flex tricks needed */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  h1       { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
  .title   { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .location{ animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both; }
  .facts   { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.26s both; }
  .links   { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.30s both; }
  .summary { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.40s both; }

  .name-row {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1rem);
  }

  .mark {
    flex-shrink: 0;
    width: clamp(2.25rem, 6vw, 3.25rem);
    height: clamp(2.25rem, 6vw, 3.25rem);
    animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }

  .mark rect {
    stroke: var(--border);
    stroke-width: 1;
  }

  .mark text { font-family: var(--font-mono); }

  h1 {
    font-size: clamp(2rem, 7vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.15;
  }

  /* Not accent-coloured: accent is reserved for things you can click */
  .title {
    font-size: 1.0625rem;
    color: var(--text);
    font-weight: 500;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  /* Separator after each item (not before), so a wrapped line on mobile
     never starts with a stray dot. */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .facts li:not(:last-child)::after {
    content: "·";
    margin: 0 0.6rem;
    color: var(--text-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* Breathing room between the meta block and the pills */
    margin-top: 0.75rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--bg-card);
    transition: border-color 0.2s, color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .link-pill:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--bg-hover);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 18%, transparent);
    text-decoration: none;
  }

  .pdf-btn {
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  .summary {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 72ch;
    line-height: 1.8;
    margin-top: 0.75rem;
  }

  /* Corpo/Personality toggle — default (no html.corpo) shows personality,
     matching Layout.astro's pre-paint default. */
  .summary-corpo { display: none; }
  :global(html.corpo) .summary-personality { display: none; }
  :global(html.corpo) .summary-corpo       { display: block; }

  /* Global reset zeroes paragraph margins — space the summary's paragraphs
     back out. The collapsed ones' margins sit inside the collapse's
     overflow:hidden child, so they vanish with it on mobile. */
  .summary p + p,
  .summary-extra p { margin-top: 0.9rem; }

  @media print {
    .hero {
      padding: 0 0 1.2rem;
      overflow: visible;
    }

    .hero::before { display: none; }

    .section-inner { gap: 0.25rem; }

    h1 { font-size: 2.3rem; }

    .links {
      gap: 0.25rem 1.25rem;
      margin-top: 0.35rem;
    }

    .link-pill {
      padding: 0;
      border: none;
      background: none;
      color: var(--text-muted);
    }

    .summary {
      max-width: none;
      line-height: 1.55;
      margin-top: 0.5rem;
    }

    .summary p + p,
    .summary-extra p { margin-top: 0.45rem; }

    /* Five personality paragraphs are too much on paper — print the first
       two. Beats Layout.astro's global ".collapse { display: block }". */
    .summary-personality .summary-extra { display: none !important; }
  }
</style>
