---
import type { Profile } from "../data/profile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="section hero" id="about">
  <div class="section-inner">
    <div class="name-row">
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="2" y="2" width="60" height="60" rx="13" fill="#111117" />
        <text x="8" y="40" font-family="'JetBrains Mono', monospace" font-weight="600" font-size="20" fill="#7b9fff">&gt;</text>
        <text x="24" y="40" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="20" fill="#eeeef4">dd</text>
      </svg>
      <h1>{profile.name}</h1>
    </div>
    <p class="title">{profile.title}</p>
    <p class="location">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      {profile.location}
    </p>

    <nav class="links" aria-label="Contact and social links">
      <a href={`mailto:${profile.email}`} class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/>
        </svg>
        Email
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
        LinkedIn
      </a>
      <a href={profile.website} target="_blank" rel="noopener noreferrer" class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        Website
      </a>
    </nav>

    <!-- Both registers render; Nav.astro's toggle (html.corpo) picks which
         one is visible via CSS, same mechanism as the light/dark tokens.
         Each keeps its first 2 paragraphs always visible and collapses the
         rest behind a "Tell me more" button on mobile only — same pattern
         as Experience.astro's bullet toggle (real <button>, no details). -->
    <div class="summary summary-personality">
      {profile.summary.slice(0, 2).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="summary-extra" id="summary-personality-extra">
        <div class="summary-extra-inner">
          {profile.summary.slice(2).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      {profile.summary.length > 2 && (
        <button
          type="button"
          class="summary-toggle"
          aria-expanded="false"
          aria-controls="summary-personality-extra"
        >
          Tell me more
        </button>
      )}
    </div>
    <div class="summary summary-corpo">
      {profile.summaryCorpo.slice(0, 2).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="summary-extra" id="summary-corpo-extra">
        <div class="summary-extra-inner">
          {profile.summaryCorpo.slice(2).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      {profile.summaryCorpo.length > 2 && (
        <button
          type="button"
          class="summary-toggle"
          aria-expanded="false"
          aria-controls="summary-corpo-extra"
        >
          Tell me more
        </button>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".summary-toggle").forEach((btn) => {
    const extra = document.getElementById(btn.getAttribute("aria-controls")!);
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "Tell me more" : "Tell me less";
      extra?.classList.toggle("is-expanded", !expanded);
    });
  });
</script>

<style>
  .hero {
    position: relative;
    /* Clamp so mobile doesn't have excessive top whitespace */
    padding-top: clamp(2.5rem, 8vw, 5rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 420px;
    background: radial-gradient(
      ellipse at 50% 30%,
      color-mix(in srgb, var(--accent) 9%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .section-inner {
    position: relative;
    /* Single-column natural stack — no flex tricks needed */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  h1       { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
  .title   { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .location{ animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both; }
  .links   { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.30s both; }
  .summary { animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.40s both; }

  .name-row {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1rem);
  }

  .mark {
    flex-shrink: 0;
    width: clamp(2.25rem, 6vw, 3.25rem);
    height: clamp(2.25rem, 6vw, 3.25rem);
    animation: fade-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }

  .mark rect {
    stroke: var(--border);
    stroke-width: 1;
  }

  h1 {
    font-size: clamp(2rem, 7vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.15;
  }

  .title {
    font-size: 1rem;
    color: var(--accent);
    font-weight: 500;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* Breathing room between the meta block and the pills */
    margin-top: 0.75rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--bg-card);
    transition: border-color 0.2s, color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .link-pill:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--bg-hover);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 18%, transparent);
    text-decoration: none;
  }

  .summary {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 72ch;
    line-height: 1.8;
    margin-top: 0.75rem;
  }

  /* Corpo/Personality toggle — default (no html.corpo) shows personality,
     matching Layout.astro's pre-paint default. */
  .summary-corpo { display: none; }
  :global(html.corpo) .summary-personality { display: none; }
  :global(html.corpo) .summary-corpo       { display: block; }

  /* Global reset zeroes paragraph margins — space the summary's
     paragraphs back out from each other explicitly. */
  .summary p + p {
    margin-top: 0.9rem;
  }

  /* Desktop: unwrap both layers so the extra paragraphs flow like any
     other — .summary-extra-inner's own p+p margin (below) is what spaces
     them, since the "p + p" rule above only matches direct children of
     .summary. */
  .summary-extra { display: contents; }
  .summary-extra-inner { display: contents; }
  .summary-extra-inner p { margin-top: 0.9rem; }

  .summary-toggle {
    display: none;
    margin-top: 0.75rem;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--accent);
    cursor: pointer;
  }

  .summary-toggle:hover { text-decoration: underline; }

  /* Mobile-only collapse — desktop always shows every paragraph, same as
     Experience.astro's bullet toggle. Animated via the grid-rows trick
     (0fr → 1fr) instead of a hard display:none/block cut. */
  @media (max-width: 639px) {
    .summary-toggle { display: inline-flex; width: fit-content; }

    .summary-extra {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s var(--ease-spring);
    }

    .summary-extra.is-expanded {
      grid-template-rows: 1fr;
    }

    .summary-extra-inner {
      display: block;
      overflow: hidden;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .summary-extra { transition: none; }
  }
</style>
