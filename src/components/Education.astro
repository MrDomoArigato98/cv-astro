---
import { Image } from "astro:assets";
import type { EducationItem } from "../data/education";

interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<section class="section" id="education">
  <div class="section-inner">
    <h2 class="section-title">Education</h2>

    <div class="edu-list">
      {items.map((item, i) => (
        <article class="edu-entry" data-animate style={`--delay: ${i * 80}ms`}>
          <div class="edu-meta">
            <span class="period">{item.period}</span>
            <span class="location">{item.location}</span>
          </div>
          <div class="edu-body">
            <h3 class="degree">{item.degree}</h3>
            <p class="institution">
              {item.logo && (
                <span class="logo-badge">
                  <Image src={item.logo} alt="" width={200} loading="eager" decoding="sync" />
                </span>
              )}
              {item.institution}
              {item.grade && <span class="grade">{item.grade}</span>}
            </p>
            <div class="bullets-wrap" id={`edu-bullets-${i}`}>
              <ul class="bullets">
                {item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>

            {/* Mobile-only collapse — same pattern as Experience.astro,
                animated via the grid-rows wrapper below. */}
            {item.bullets.length > 0 && (
              <button
                type="button"
                class="bullets-toggle"
                aria-expanded="false"
                aria-controls={`edu-bullets-${i}`}
              >
                Tell me more
              </button>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("#education .bullets-toggle").forEach((btn) => {
    const list = document.getElementById(btn.getAttribute("aria-controls")!);
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "Tell me more" : "Tell me less";
      list?.classList.toggle("is-expanded", !expanded);
    });
  });
</script>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .edu-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: clamp(1rem, 4vw, 1.5rem);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .edu-entry:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent),
                0 8px 28px -6px color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-2px);
  }

  @media (min-width: 640px) {
    .edu-entry {
      grid-template-columns: 9rem 1fr;
      gap: 1.5rem;
    }
  }

  .edu-meta {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  @media (min-width: 640px) {
    .edu-meta {
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 0.15rem;
    }
  }

  .period {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    white-space: nowrap;
  }

  .location {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .degree {
    font-size: 1rem;
    font-weight: 600;
  }

  .institution {
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .grade {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-hover);
    border: 1px solid var(--border);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-weight: 400;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    padding: 0.25rem 0.4rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 5px;
    flex-shrink: 0;
  }

  .logo-badge img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 3rem;
    object-fit: contain;
  }

  .bullets-wrap {
    margin-top: 0.85rem;
  }

  .bullets {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bullets li {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ─── Mobile-only "Tell me more" for the bullet list ────────────
     Same grid-rows animation as Experience.astro. */
  .bullets-toggle {
    display: none;
    margin-top: 0.6rem;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--accent);
    cursor: pointer;
  }

  .bullets-toggle:hover { text-decoration: underline; }

  @media (max-width: 639px) {
    .bullets-toggle { display: inline-flex; width: fit-content; }

    .bullets-wrap {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s var(--ease-spring);
    }

    .bullets-wrap.is-expanded {
      grid-template-rows: 1fr;
    }

    .bullets-wrap > .bullets {
      overflow: hidden;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bullets-wrap { transition: none; }
  }
</style>
