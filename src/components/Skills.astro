---
import type { SkillCategory } from "../data/skills";

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
---

<section class="section" id="skills">
  <div class="section-inner">
    <h2 class="section-title">Skills</h2>

    <p class="skills-intro">
      What I reach for when something's broken — or when a ticket says I have to.
    </p>
    <p class="skills-note">
      Half of this list is "read the docs once, shipped anyway." The other half I actually know. It's on me to figure it out.
    </p>

    <!-- One row per category (label | tags) rather than a card grid, so
         rows of different lengths never leave a ragged grid. -->
    <dl class="skills-list">
      {categories.map((cat, i) => (
        <div class="skill-row" data-animate style={`--delay: ${i * 50}ms`}>
          <dt class="cat-name">{cat.category}</dt>
          <dd>
            <ul class="tag-list">
              {cat.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .skills-intro {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 65ch;
    line-height: 1.7;
  }

  .skills-note {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--text-dim);
    max-width: 65ch;
    line-height: 1.6;
    margin-top: 0.35rem;
  }

  /* The joke undercuts the list — keep it out of recruiter-safe mode */
  :global(html.corpo) .skills-note { display: none; }

  .skills-list {
    margin-top: 1.75rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: 0.9rem 0;
  }

  .skill-row:first-child { padding-top: 0; }
  .skill-row + .skill-row { border-top: 1px solid var(--border); }

  /* Same label column width as the Experience/Education dates */
  @media (min-width: 640px) {
    .skill-row {
      grid-template-columns: 9rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .cat-name {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  @media print {
    .skills-intro,
    .skills-note { display: none; }

    .skills-list { margin-top: 0; }

    .skill-row {
      grid-template-columns: 10rem 1fr;
      gap: 1rem;
      padding: 0.2rem 0;
      border: none !important;
      break-inside: avoid;
    }

    .tag-list { gap: 0.25rem; }
    .tag { padding: 0.05rem 0.4rem; font-size: 0.75rem; }
  }
</style>
