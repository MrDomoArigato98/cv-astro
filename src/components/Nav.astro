---
const links = [
  { label: "About",      href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Education",  href: "#education" },
  { label: "Skills",     href: "#skills" },
  { label: "Projects",   href: "#projects" },
  { label: "Contact",    href: "#contact" },
];
---

<header>
  <nav>
    <!-- Brand mark — same design as the favicon, inlined so it renders in
         the site's actual JetBrains Mono (favicons can't rely on a webfont
         being available, but the page already loads it). -->
    <a href="#" class="brand" aria-label="Back to top">
      <svg width="32" height="32" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="2" y="2" width="60" height="60" rx="13" fill="#111117" />
        <text x="8" y="40" font-family="'JetBrains Mono', monospace" font-weight="600" font-size="20" fill="#7b9fff">&gt;</text>
        <text x="24" y="40" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="20" fill="#eeeef4">dd</text>
      </svg>
    </a>

    <!-- Desktop link strip — hidden on mobile -->
    <div class="link-scroll">
      <ul class="desktop-links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="nav-actions">
      <!-- Hamburger — only visible on mobile -->
      <button id="menu-toggle" class="icon-btn mobile-only" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="icon-hamburger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle light/dark mode">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Corpo/Personality toggle — default is personality (Layout.astro's
           pre-paint script), this switches Summary + Contact into a more
           conservative register. Wrapped so the first-visit nudge bubble
           can anchor to it. -->
      <div class="mode-toggle-wrap">
        <button id="mode-toggle" class="icon-btn mode-btn" aria-label="Toggle Corpo/Personality mode">
          <svg class="icon-briefcase" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
          </svg>
          <svg class="icon-smile" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
          <!-- Label follows the same "shows what you'd switch INTO" convention
               as the icon swap above. -->
          <span class="mode-label mode-label-briefcase">Recruiter-safe mode</span>
          <span class="mode-label mode-label-smile">Personality Mode</span>
        </button>

        <div id="mode-nudge" class="mode-nudge" aria-hidden="true">
          Now you can try recruiter-safe mode!
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile dropdown — toggled by the hamburger button -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} class="mobile-link">{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle")!;
  const mobileMenu = document.getElementById("mobile-menu")!;
  const themeToggle = document.getElementById("theme-toggle")!;
  const modeToggle = document.getElementById("mode-toggle")!;
  const modeNudge = document.getElementById("mode-nudge")!;

  function openMenu() {
    mobileMenu.classList.add("is-open");
    menuToggle.setAttribute("aria-expanded", "true");
    mobileMenu.setAttribute("aria-hidden", "false");
  }

  function closeMenu() {
    mobileMenu.classList.remove("is-open");
    menuToggle.setAttribute("aria-expanded", "false");
    mobileMenu.setAttribute("aria-hidden", "true");
  }

  menuToggle.addEventListener("click", () => {
    mobileMenu.classList.contains("is-open") ? closeMenu() : openMenu();
  });

  // Close when any mobile nav link is tapped
  mobileMenu.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  themeToggle.addEventListener("click", () => {
    const isLight = document.documentElement.classList.toggle("light");
    localStorage.setItem("theme", isLight ? "light" : "dark");
  });

  function dismissModeNudge() {
    modeNudge.classList.remove("is-visible");
  }

  modeToggle.addEventListener("click", () => {
    const isCorpo = document.documentElement.classList.toggle("corpo");
    localStorage.setItem("mode", isCorpo ? "corpo" : "personality");
    dismissModeNudge();
  });

  // Hint pointing at the mode toggle — shows on every page load (not just
  // first-visit), so it's always there to point new eyes at the toggle.
  // Stays up a full 6s regardless of clicks elsewhere on the page; only
  // clicking the toggle itself (above) dismisses it early.
  setTimeout(() => {
    modeNudge.classList.add("is-visible");
    setTimeout(dismissModeNudge, 6000);
  }, 900);
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    height: 3rem;
  }

  /* ── Brand mark ───────────────────────────────────────────────── */
  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: 8px;
    line-height: 0;
    transition: transform 0.2s;
  }

  .brand:hover {
    transform: translateY(-1px);
    background: none;
  }

  .brand svg {
    display: block;
  }

  .brand svg rect {
    stroke: var(--border);
    stroke-width: 1;
  }

  /* ── Desktop link strip ───────────────────────────────────────── */
  .link-scroll {
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .link-scroll::-webkit-scrollbar { display: none; }

  .desktop-links {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem;
    width: max-content;
  }

  a {
    display: block;
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    white-space: nowrap;
    color: var(--text-muted);
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }

  a:hover {
    color: var(--text);
    background: var(--bg-hover);
    text-decoration: none;
  }

  a.active {
    color: var(--text);
    background: var(--bg-hover);
  }

  /* ── Shared icon button style ─────────────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  /* Mode toggle grows to fit its label instead of staying icon-only */
  .mode-btn {
    width: auto;
    padding: 0 0.65rem;
    gap: 0.4rem;
  }

  .mode-label {
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Link strip is hidden below 600px, leaving nav-actions room to itself —
     only bail to icon-only on genuinely tiny screens. */
  @media (max-width: 340px) {
    .mode-label { display: none !important; }
    .mode-btn { width: 2rem; padding: 0; gap: 0; }
  }

  /* ── Hamburger visibility ────────────────────────────────────── */
  /* Hide hamburger on desktop; hide desktop links on mobile */
  .mobile-only { display: none; }

  @media (max-width: 600px) {
    .link-scroll  { display: none; }
    .mobile-only  { display: flex; }
  }

  /* Hamburger ↔ close icon swap driven by aria-expanded */
  .icon-close { display: none; }
  #menu-toggle[aria-expanded="true"] .icon-hamburger { display: none; }
  #menu-toggle[aria-expanded="true"] .icon-close     { display: block; }

  /* ── Mobile dropdown ─────────────────────────────────────────── */
  .mobile-menu {
    display: none;
    overflow: hidden;
  }

  /* Only render the dropdown DOM on mobile — avoids it briefly flashing on desktop */
  @media (max-width: 600px) {
    .mobile-menu {
      display: block;
      max-height: 0;
      transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      border-top: 1px solid transparent;
    }

    .mobile-menu.is-open {
      /* Large enough to never clip content */
      max-height: 400px;
      border-top-color: var(--border);
    }
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0.5rem 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-link {
    display: block;
    padding: 0.6rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
    border-radius: 6px;
  }

  .mobile-link:hover {
    color: var(--text);
    background: var(--bg-hover);
    text-decoration: none;
  }

  /* ── Theme icon swap ─────────────────────────────────────────── */
  .icon-moon { display: none; }
  :global(html.light) .icon-sun  { display: none; }
  :global(html.light) .icon-moon { display: block; }

  /* ── Corpo/Personality icon swap ─────────────────────────────────
     Same convention as sun/moon: the icon shown is what you'd switch
     INTO. Default (personality) shows the briefcase (switch to corpo);
     html.corpo shows the smiley (switch back to personality). */
  .icon-smile { display: none; }
  :global(html.corpo) .icon-briefcase { display: none; }
  :global(html.corpo) .icon-smile     { display: block; }

  .mode-label-smile { display: none; }
  :global(html.corpo) .mode-label-briefcase { display: none; }
  :global(html.corpo) .mode-label-smile     { display: inline; }

  /* ── First-visit mode nudge ──────────────────────────────────── */
  .mode-toggle-wrap {
    position: relative;
  }

  .mode-nudge {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: max-content;
    max-width: 180px;
    padding: 0.5rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    box-shadow: 0 8px 24px -6px color-mix(in srgb, var(--accent) 30%, transparent);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
    z-index: 50;
  }

  /* Small triangle pointing back up at the toggle button */
  .mode-nudge::before {
    content: "";
    position: absolute;
    top: -5px;
    right: 10px;
    width: 9px;
    height: 9px;
    background: var(--bg-card);
    border-left: 1px solid var(--accent);
    border-top: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  .mode-nudge.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mode-nudge { transition: none; }
  }
</style>
